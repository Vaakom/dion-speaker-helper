{
  "manifest_version": 3,
  "name": "Dion Speaker Helper",
  "version": "0.7.3",
  "description": "Локальный журнал имён говорящих для Dion Secretary. Требует проверки индикатора речи.",
  "permissions": [
    "storage",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://dion.vc/*",
    "https://*.dion.vc/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://dion.vc/*",
        "https://*.dion.vc/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
